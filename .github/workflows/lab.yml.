name: Laboratorio 20 EUR

on:
  schedule:
    - cron: "20 6 * * *"   # cada dia a las 06:20 UTC (08:20 en Madrid en verano, 07:20 en invierno)
  workflow_dispatch:
    inputs:
      modo_prueba:
        description: "Modo prueba: comprueba la conexion sin enviar ordenes ni guardar nada"
        type: boolean
        default: true

permissions:
  contents: write   # para guardar el registro en data/

concurrency:
  group: laboratorio-20eur
  cancel-in-progress: false

jobs:
  ejecutar:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v5

      - uses: actions/setup-python@v6
        with:
          python-version: "3.12"

      - name: Instalar dependencias
        run: python -m pip install --quiet -r requirements.txt

      - name: Ejecutar el bot
        id: bot
        continue-on-error: true
        env:
          ALPACA_KEY_ID: ${{ secrets.ALPACA_KEY_ID }}
          ALPACA_SECRET_KEY: ${{ secrets.ALPACA_SECRET_KEY }}
          DRY_RUN: ${{ github.event_name == 'workflow_dispatch' && inputs.modo_prueba && '1' || '0' }}
        run: python bot.py

      - name: Guardar registro en el repositorio
        if: always()
        run: |
          git config user.name "laboratorio-20eur[bot]"
          git config user.email "laboratorio-20eur@users.noreply.github.com"
          git add data/ || true
          if git diff --cached --quiet; then
            echo "Nada nuevo que guardar."
          else
            git commit -m "Registro $(date -u +%Y-%m-%d)"
            git push
          fi

      - name: Marcar el trabajo en rojo si el bot fallo
        if: steps.bot.outcome == 'failure'
        run: |
          echo "El bot ha fallado. Mira el paso 'Ejecutar el bot' y data/registro.csv."
          exit 1
